# Fine-grained GitHub personal access token (keep the real value in .env.local).
GITHUB_TOKEN=

# Admin (/admin). Required in production: without it the admin login is disabled.
ADMIN_PASSWORD=
# Optional: separate secret used to sign the admin session cookie (defaults to ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# Contact form (Resend). Without a key, messages are only logged.
RESEND_API_KEY=
# Optional overrides. With the default onboarding sender, Resend only delivers to the account owner's address.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Vercel Blob store where the admin saves its changes in production
# (Vercel's filesystem is read-only). Added automatically when a Blob store is linked to the project.
BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public": must match the access type chosen when the store was created.
BLOB_ACCESS=
